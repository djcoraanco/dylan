# Example environment variables (no real secrets here)
# Copy to `.env` and fill with production values locally and in Coolify.

# General
NODE_ENV=production

# Template banner options (used by vite.config.js)
TEMPLATE_BANNER_SCRIPT_URL=
TEMPLATE_REDIRECT_URL=
TEMPLATE_BANNER_MAIN_TEXT=
TEMPLATE_BANNER_CTA_TEXT=
TEMPLATE_BANNER_THEME=

# Add any other `VITE_` or backend variables your deployment needs below
# e.g. VITE_API_BASE_URL=, DATABASE_URL=, SENTRY_DSN=